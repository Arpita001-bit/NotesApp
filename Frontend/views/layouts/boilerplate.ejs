<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Notes App</title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='14' y='6' width='40' height='52' rx='6' fill='%23c9b8e8' stroke='%236b4c8a' stroke-width='2.5'/%3E%3Ccircle cx='22' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Ccircle cx='32' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Ccircle cx='42' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Cline x1='21' y1='26' x2='47' y2='26' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3Cline x1='21' y1='34' x2='47' y2='34' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3Cline x1='21' y1='42' x2='38' y2='42' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E" />

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Your custom styles -->
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/showNote">Notes App</a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/showNote">All Notes</a>
          </li>

          <% if (currentUser) { %>
            <li class="nav-item">
              <a class="nav-link" href="/note/createNote">New Note</a>
            </li>
            <li class="nav-item">
              <form action="/logout" method="POST" class="d-inline">
                <button type="submit" class="nav-link btn btn-link" style="border:none;background:none;">
                  Logout
                </button>
              </form>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">Login</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/createAuthor">Register</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container mt-4 mb-5">
    <%- include('../flash') %>
    <%- body %>
  </main>

  <footer class="text-center text-muted py-3">
    <small>&copy; <%= new Date().getFullYear() %> Notes App</small>
  </footer>

  <!-- Bootstrap JS bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>