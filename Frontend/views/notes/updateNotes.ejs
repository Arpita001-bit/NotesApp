<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Update note</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
  <div class="container py-5" style="max-width: 500px;">
    <div class="form-card">
      <h1 class="mb-4">Update a note</h1>
      <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='14' y='6' width='40' height='52' rx='6' fill='%23c9b8e8' stroke='%236b4c8a' stroke-width='2.5'/%3E%3Ccircle cx='22' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Ccircle cx='32' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Ccircle cx='42' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Cline x1='21' y1='26' x2='47' y2='26' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3Cline x1='21' y1='34' x2='47' y2='34' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3Cline x1='21' y1='42' x2='38' y2='42' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E" />
      <form action="/note/<%= note._id %>/updateNotes?_method=PUT" method="POST">
        <div class="mb-3">
          <label class="form-label">Title</label>
          <input type="text" name="title" class="form-control" value="<%= note.title %>" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Note</label>
          <textarea name="note" class="form-control" rows="4" required><%= note.note %></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label">Author</label>
          <input type="text" name="author" class="form-control" value="<%= note.author %>" required>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-grow-1">Update note</button>
          <a href="/note/showNote" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>