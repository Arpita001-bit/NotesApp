<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <title>Notes</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='14' y='6' width='40' height='52' rx='6' fill='%23c9b8e8' stroke='%236b4c8a' stroke-width='2.5'/%3E%3Ccircle cx='22' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Ccircle cx='32' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Ccircle cx='42' cy='8' r='2.5' fill='%23ffffff' stroke='%236b4c8a' stroke-width='1.5'/%3E%3Cline x1='21' y1='26' x2='47' y2='26' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3Cline x1='21' y1='34' x2='47' y2='34' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3Cline x1='21' y1='42' x2='38' y2='42' stroke='%23ffffff' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E" />
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">





  <nav>
    <a class="navbar-brand" href="/showNote">
  <svg width="22" height="22" viewBox="0 0 64 64" style="vertical-align: -4px; margin-right: 6px;">
    <rect x="14" y="6" width="40" height="52" rx="6" fill="#c9b8e8" stroke="#6b4c8a" stroke-width="2.5"/>
    <circle cx="22" cy="8" r="2.5" fill="#ffffff" stroke="#6b4c8a" stroke-width="1.5"/>
    <circle cx="32" cy="8" r="2.5" fill="#ffffff" stroke="#6b4c8a" stroke-width="1.5"/>
    <circle cx="42" cy="8" r="2.5" fill="#ffffff" stroke="#6b4c8a" stroke-width="1.5"/>
    <line x1="21" y1="26" x2="47" y2="26" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="21" y1="34" x2="47" y2="34" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="21" y1="42" x2="38" y2="42" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
  </svg>
  NotesApp
</a>
 
  <div class="auth-links">
    <% if (currentUser) { %>
      <span>Hi, <%= currentUser.email %></span>
      <button id="logout-btn">Logout</button>
    <% } else { %>
      <button onclick="location.href='/createAuthor'">Sign Up</button>
      <button onclick="location.href='/login'">Login</button>
    <% } %>
  </div>
</nav>

<script>
  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    const res = await fetch("/logout", { method: "POST" });
    if (res.ok) location.href = "/showNote";
  });
</script>

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>Notes</h1>
      <a href="/note/createNote" class="btn btn-primary">Create new Note</a>
    </div>

    <div class="row g-3">
      <% notes.forEach(note => { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title"><%= note.title %></h5>
              <p class="card-text"><%= note.note %></p>
              <p class="text-muted small mb-0">Author : <%= note.author %></p>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
              <a href="/note/<%= note._id %>/updateNotes" class="btn btn-sm btn-outline-secondary">Edit</a>
              <form action="/note/<%= note._id %>?_method=DELETE" method="POST" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</body>
</html>