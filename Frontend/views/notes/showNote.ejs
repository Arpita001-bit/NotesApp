<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Notes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>Notes</h1>
      <a href="/note/createNote" class="btn btn-primary">Create new Note</a>
    </div>

    <div class="row g-3">
      <% notes.forEach(note => { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title"><%= note.title %></h5>
              <p class="card-text"><%= note.note %></p>
              <p class="text-muted small mb-0">Author : <%= note.author %></p>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
              <a href="/note/<%= note._id %>/updateNotes" class="btn btn-sm btn-outline-secondary">Edit</a>
              <form action="/note/<%= note._id %>?_method=DELETE" method="POST" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</body>
</html>